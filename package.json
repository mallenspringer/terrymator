{
  "name": "terrymator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:browser": "playwright test --project=chromium tests/browser",
    "test:browser:chrome": "playwright test --project=chrome tests/browser",
    "test:browser:edge": "playwright test --project=msedge tests/browser",
    "test:e2e": "playwright test --project=chromium tests/e2e",
    "test:replay": "vitest run --project replay",
    "test:bench": "vitest run --project bench",
    "verify:bundle": "node scripts/verify-prod-bundle.mjs",
    "verify": "npm run lint && npm run typecheck && npm run test:unit && npm run test:integration && npm run test:browser && npm run test:e2e && npm run test:replay && npm run build && npm run verify:bundle"
  },
  "dependencies": {
    "fflate": "0.8.3",
    "gifenc": "1.0.3",
    "mediabunny": "1.66.4",
    "pixi-filters": "6.1.5",
    "pixi.js": "8.23.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@types/node": "24.19.4",
    "@types/pngjs": "6.0.5",
    "@types/react": "19.3.3",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "fast-check": "4.11.0",
    "globals": "17.14.0",
    "pngjs": "7.0.0",
    "prettier": "3.10.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.74.0",
    "vite": "8.3.8",
    "vitest": "5.1.2"
  }
}
